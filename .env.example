# ============================================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this to .env and fill in your values
# Add these in Railway → your service → Variables
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_NAME=AI Telegram CRM
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000

# ── Database (Railway provides this automatically) ───────────
# In Railway: add a PostgreSQL plugin → it sets DATABASE_URL for you
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

# ── Redis (Railway provides this automatically) ──────────────
# In Railway: add a Redis plugin → it sets REDIS_URL for you
REDIS_URL=redis://default:password@host:6379

# ── Telegram API ─────────────────────────────────────────────
# Get from: https://my.telegram.org → API development tools
TELEGRAM_API_ID=          # e.g. 1234567
TELEGRAM_API_HASH=        # e.g. abc123def456...
TELEGRAM_PHONE=           # e.g. +491701234567
TELEGRAM_SESSION_PATH=./sessions
TELEGRAM_SESSION_NAME=telegram_session

# ── Claude API ───────────────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=        # e.g. sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
CLAUDE_TEMPERATURE=0.7

# ── Embeddings (optional, for semantic search) ───────────────
# Get from: https://www.voyageai.com
VOYAGE_API_KEY=           # e.g. pa-...
EMBEDDING_MODEL=voyage-3
ENABLE_VECTOR_MEMORY=true

# ── Security ─────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
SECRET_KEY=               # min 32 chars random string

# ── CORS (set to your Vercel frontend URL) ───────────────────
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# ── Features ─────────────────────────────────────────────────
ENABLE_AI_RESPONSES=true
ENABLE_AUTO_LEAD_SCORING=true
ENABLE_BACKGROUND_JOBS=true
